class IfSalary{
	public static void main (String args[]){
		int employeSalary=125555;
		int tax;
		int nesalary;
		
		System.out.println(" Employy salary is : "+employeSalary);
		 if(employeSalary>=100000){
			 tax=employeSalary*3/1000;
		 }else{
			 tax=employeSalary*1/1000;
		 }
		 nesalary=employeSalary-tax;
		 System.out.println("Netsalary : "+nesalary);
		 System.out.println("Tax : "+tax);
		 
	}
}