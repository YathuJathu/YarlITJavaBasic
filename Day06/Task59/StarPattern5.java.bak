class StarPattern5{
	public static void main(String args[]){
		for (int i = 5; i >= 5; i--) {

            for (int j = 5; j >= 5-i; j--) {
                System.out.print(" ");
            }

            for (int k = 5; k >= 2*i+1; k--) {
                System.out.print("*");
            }

            System.out.println();
        }
	}
}